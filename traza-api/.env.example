APP_NAME=TRAZA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Se guarda en UTC y se presenta en America/Lima.
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
# Dominios de la SPA que pueden autenticarse con cookie de sesión.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
SESSION_DOMAIN=localhost
FRONTEND_URL=http://localhost:5173

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=traza
DB_USERNAME=traza
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=traza

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_CA_FILE=

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="traza@vivatech-peru.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=traza
AWS_SECRET_ACCESS_KEY=secret123
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=traza
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# ---- Codificación EPC (tarea 0.2) -------------------------------------------
TRAZA_EPC_SCHEME=sgtin-96
# ⚠️ Obtener de GS1 Perú antes de emitir etiquetas.
TRAZA_GS1_COMPANY_PREFIX=
TRAZA_EPC_FILTER=1
# Solo para gid-96: valor propio, sin GS1.
TRAZA_GID_MANAGER_NUMBER=1
TRAZA_EPC_MASK=3035D9
TRAZA_EPC_TEST_PREFIX=FFFF
# Generar con: openssl rand -hex 32
TRAZA_TAG_ACCESS_MASTER_KEY=

# ---- Inventario --------------------------------------------------------------
TRAZA_MISSING_THRESHOLD=2
TRAZA_CYCLE_AUTOCLOSE=240
TRAZA_MIN_ACCURACY=95.0

# ---- Portal antihurto --------------------------------------------------------
TRAZA_PORTAL_ALARM=true
TRAZA_PORTAL_GRACE=120
TRAZA_PORTAL_CONFIDENCE=0.7
TRAZA_PORTAL_IGNORE_UNKNOWN=true

# ---- Ingesta -----------------------------------------------------------------
TRAZA_MAX_BATCH=1000
TRAZA_READS_RETENTION=3

# ---- Operaciones -------------------------------------------------------------
TRAZA_OPS_EMAIL=
