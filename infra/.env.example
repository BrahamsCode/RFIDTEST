# =============================================================================
#  TRAZA — Variables de entorno
#  Copiar a .env (desarrollo) o .env.prod (producción) y rellenar.
#  NUNCA versionar el fichero relleno.
# =============================================================================

# ---- Aplicación --------------------------------------------------------------
APP_NAME=TRAZA
APP_ENV=local                       # local | staging | production
APP_KEY=                            # php artisan key:generate
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC                    # se guarda en UTC; se presenta en America/Lima
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

# ---- Base de datos -----------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=traza
DB_USERNAME=traza
DB_PASSWORD=

# ---- Redis -------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis

# ---- Tiempo real (Reverb) ----------------------------------------------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# ---- MQTT --------------------------------------------------------------------
MQTT_HOST=mosquitto
MQTT_PORT=1883                      # 8883 con TLS en producción
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_CA_FILE=

# ---- Almacenamiento ----------------------------------------------------------
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=traza
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# =============================================================================
#  Parámetros específicos de TRAZA
# =============================================================================

# ---- Codificación EPC --------------------------------------------------------
# Esquema: sgtin-96 (requiere prefijo GS1) | gid-96 | propietario
TRAZA_EPC_SCHEME=sgtin-96
TRAZA_GS1_COMPANY_PREFIX=           # p.ej. 7751234  ⚠️ obtener de GS1 Perú
TRAZA_EPC_FILTER=1                  # 1 = unidad de consumo
# Prefijo hex propio. El middleware descarta todo EPC que no empiece así.
TRAZA_EPC_MASK=3035D9
# Prefijo reservado para tags de laboratorio. Producción los rechaza.
TRAZA_EPC_TEST_PREFIX=FFFF
# Clave maestra para derivar el access password de cada tag (HMAC-SHA256).
# 32 bytes en hex. Generar con: openssl rand -hex 32
TRAZA_TAG_ACCESS_MASTER_KEY=

# ---- Inventario --------------------------------------------------------------
# Ciclos consecutivos sin detectar antes de declarar una prenda perdida.
# 1 borra stock real ante un fallo de lectura. 5 detecta la merma tarde.
TRAZA_MISSING_THRESHOLD=2
TRAZA_CYCLE_AUTOCLOSE=240           # minutos antes de cerrar un ciclo olvidado
TRAZA_MIN_ACCURACY=95.0             # alerta si un ciclo baja de este porcentaje

# ---- Portal antihurto --------------------------------------------------------
TRAZA_PORTAL_ALARM=true
# Segundos tras la venta durante los que cruzar el portal es normal.
TRAZA_PORTAL_GRACE=120
# Confianza mínima de la clasificación de dirección para disparar la alarma.
TRAZA_PORTAL_CONFIDENCE=0.7
TRAZA_PORTAL_IGNORE_UNKNOWN=true    # no alarmar por EPC ajenos

# ---- Ingesta -----------------------------------------------------------------
TRAZA_MAX_BATCH=1000
TRAZA_READS_RETENTION=3             # meses de lecturas crudas en caliente

# ---- Operaciones -------------------------------------------------------------
TRAZA_OPS_EMAIL=
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025

# =============================================================================
#  traza-edge (se despliega en cada tienda, con su propio .env)
# =============================================================================
TRAZA_API_URL=https://traza.ejemplo.pe
TRAZA_DEVICE_CODE=EDGE-LIM01
TRAZA_DEVICE_TOKEN=                 # generado al dar de alta el dispositivo
TRAZA_LOCATION_CODE=LIM-01

# Modo del lector: llrp | webhook | simulator
READER_MODE=simulator
READER_HOST=192.168.10.21
READER_PORT=5084

# Perfil regulatorio. ⚠️ Debe corresponder a la normativa del MTC (docs/01, §3)
READER_REGION=FCC-PE

# Simulador (solo desarrollo)
SIMULATOR_SCENARIO=inventario_limpio
SIMULATOR_POPULATION=5000
SIMULATOR_MISS_RATE=0.03
SIMULATOR_STRAY_RATE=0.02

# Buffer local
EDGE_BUFFER_PATH=/app/data/buffer.sqlite
EDGE_BUFFER_MAX_ROWS=2000000
EDGE_FLUSH_BATCH=500

# Impresora
PRINTER_HOST=192.168.10.31
PRINTER_PORT=9100
