# Borde de tienda. Copiar a `.env.edge` en el equipo y rellenar.
#
#   docker compose -f docker-compose.edge.yml --env-file .env.edge up -d
#
# `.env.edge` NO se versiona: lleva el token del dispositivo.

# ------------------------------------------------------------------- imagen
REGISTRY=registry.traza.pe
TAG=1.0.0

# ------------------------------------------------------------- este equipo
#
# El código es el que figura en el inventario de dispositivos, y el token lo
# entrega el central **una sola vez** al dar de alta el equipo. Si se pierde,
# no se recupera: hay que volver a dar de alta el borde y se emite otro.
TRAZA_DEVICE_CODE=EDGE-LIM01
TRAZA_DEVICE_TOKEN=
TRAZA_LOCATION_CODE=LIM-01

# --------------------------------------------------------------- el lector
#
# `llrp` para lectores fijos que hablan LLRP. `simulator` solo para probar el
# despliegue sin hardware conectado — nunca en una tienda en marcha: produce
# lecturas sintéticas que acabarían en `tag_reads` como si fueran reales.
READER_MODE=llrp
READER_HOST=192.168.1.50
READER_PORT=5084

# Prefijo EPC de la organización. Filtra en el borde las etiquetas ajenas,
# que en Gamarra son la mayoría de lo que se lee.
EPC_MASK=3035D9

# ---------------------------------------------------------------- el portal
#
# Solo en las tiendas con antenas en la puerta.
PORTAL_ENABLED=false
PORTAL_MIN_CONFIDENCE=0.7
